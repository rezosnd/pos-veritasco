NODE_ENV=production
PORT=5000
FRONTEND_URL=https://your-app.vercel.app

# ── MongoDB Atlas ──────────────────────────────────────────────────────────────
MONGODB_URI=example

# ── Redis (RedisLabs ap-south-1) ──────────────────────────────────────────────
REDIS_URL=example
REDIS_HOST=example
REDIS_PORT=example
REDIS_PASSWORD=example
REDIS_USER=example

# ── JWT (Production — Generated Strong Secrets) ──────────────────────────────
JWT_SECRET=example
JWT_EXPIRES_IN=7d   
JWT_REFRESH_SECRET=example
JWT_REFRESH_EXPIRES_IN=30d  

# ── Session ────────────────────────────────────────────────────────────────────
SESSION_EXPIRY_HOURS=12
ENFORCE_QR_TOKEN=true # Set to false to support permanent static QR codes without tokens

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_ORDER_MAX=30

# ── File Upload ───────────────────────────────────────────────────────────────
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# ── CORS — UPDATE with your real Vercel URL ───────────────────────────────────
ALLOWED_ORIGINS=https://your-app.vercel.app

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=warn
LOG_DIR=./logs

# ── Seed ──────────────────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=example
SUPER_ADMIN_PASSWORD=example
